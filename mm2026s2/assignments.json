{
  "schema": "classroom50/assignments/v1",
  "assignments": [
    {
      "slug": "hello-asm",
      "name": "Hello ASM",
      "mode": "individual",
      "autograder": "default",
      "feedback_pr": false,
      "copy_about": true,
      "copy_topics": true,
      "template": {
        "owner": "DC-UFSCar",
        "repo": "getting-started-asm",
        "branch": "main"
      },
      "runtime": {
        "apt": [
          "gcc-riscv64-linux-gnu",
          "binutils-riscv64-linux-gnu",
          "qemu-user",
          "qemu-user-static"
        ]
      },
      "tests": [
        {
          "name": "Exit code",
          "type": "run",
          "run": "qemu-riscv64 ./hello.elf",
          "points": 5,
          "setup": "riscv64-linux-gnu-as hello.s -o hello.o && riscv64-linux-gnu-ld hello.o -o hello.elf",
          "exit-code": 42
        },
        {
          "name": "Print hello",
          "type": "io",
          "run": "qemu-riscv64 ./hello.elf",
          "points": 5,
          "setup": "riscv64-linux-gnu-as hello.s -o hello.o && riscv64-linux-gnu-ld hello.o -o hello.elf",
          "comparison": "included",
          "expected": "Hello RISC-V!"
        }
      ],
      "submission_mode": "every-push"
    },
    {
      "slug": "hello-verilog",
      "name": "Hello Verilog",
      "mode": "individual",
      "autograder": "default",
      "feedback_pr": true,
      "copy_about": true,
      "copy_topics": true,
      "template": {
        "owner": "DC-UFSCar",
        "repo": "getting-started",
        "branch": "main"
      },
      "runtime": {
        "apt": [
          "iverilog"
        ]
      },
      "tests": [
        {
          "name": "setup",
          "type": "run",
          "run": "./setup.sh",
          "points": 0,
          "timeout": 120
        },
        {
          "name": "Test hello",
          "type": "run",
          "run": "./run.sh",
          "points": 10
        }
      ]
    },
    {
      "slug": "trabalho-0-up1",
      "name": "Trabalho 1 (uP1)",
      "mode": "group",
      "autograder": "default",
      "feedback_pr": true,
      "no_autograder": true,
      "copy_about": true,
      "copy_topics": true,
      "template": {
        "owner": "menotti",
        "repo": "up1",
        "branch": "master"
      },
      "max_group_size": 7,
      "grading": {
        "mode": "manual",
        "max_points": 10
      }
    }
  ]
}
